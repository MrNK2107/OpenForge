# Copy to .env.local. Leave the Supabase values empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required whenever Supabase is configured. API routes use it to bypass RLS;
# the anon key is read-only public data. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only. Random string, >= 32 chars (e.g. `openssl rand -hex 32`). Required in production;
# in dev a random one is generated at startup if unset.
SESSION_SECRET=
